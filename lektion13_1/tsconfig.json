{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "es2022",
    "target": "es2022",
    // Style Options
    "noImplicitAny": true,
    // "noImplicitReturns": true,
    // Recommended Options
    "strict": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}